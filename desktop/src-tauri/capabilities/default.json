{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base permissions for the desktop shell: the verified local-engine start command, opening external links in the system browser, and the window changes the Winamp mode and the visualiser window make.",
  "windows": [
    "main",
    "visualizer"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-decorations",
    "core:window:allow-set-resizable",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "core:window:allow-set-position",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-set-shadow",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:webview:allow-set-webview-zoom"
  ]
}
